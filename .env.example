# Kopieer naar .env, zet rechten op 600 en vervang iedere CHANGE_ME-waarde.
# Gebruik voor het databasewachtwoord een URL-veilige waarde: openssl rand -hex 32
POSTGRES_DB="realtime_attendance"
POSTGRES_USER="realtime_attendance"
POSTGRES_PASSWORD="CHANGE_ME_URL_SAFE_DATABASE_PASSWORD"

# Docker Compose stelt DATABASE_URL samen uit POSTGRES_*; definieer hem hier niet.
APP_URL="https://attendance.sv-realtime-gaming.nl"
SESSION_SECRET="CHANGE_ME_OPENSSL_RAND_HEX_64"
QR_SECRET="CHANGE_ME_DIFFERENT_OPENSSL_RAND_HEX_64"
CONGRESSUS_API_BASE_URL="https://api.congressus.nl/v30"
CONGRESSUS_API_KEY="CHANGE_ME"
CONGRESSUS_BASE_URL="https://www.sv-realtime.nl"
CONGRESSUS_CLIENT_ID="CHANGE_ME"
CONGRESSUS_CLIENT_SECRET="CHANGE_ME"
CONGRESSUS_REDIRECT_URI="https://attendance.sv-realtime-gaming.nl/api/auth/callback"
CONGRESSUS_BOARD_GROUP_SLUG=""
CONGRESSUS_BOARD_USER_IDS=""
DEMO_MODE="false"
DATA_RETENTION_DAYS="730"
CRON_SECRET=""
